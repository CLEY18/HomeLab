# ── Shared ───────────────────────────────────────────────
PASSWORD_URLENC=
TZ=Europe/Kyiv
COMPOSE_PROFILES=ai

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=workspace
POSTGRES_INIT_SQL_PATH=./init.sql
POSTGRES_DATA_PATH=./data/db/postgres
POSTGRES_BACKUP_PATH=./data/db/backups/postgres

# ── MongoDB ─────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_DATA_PATH=./data/db/mongo
MONGO_BACKUP_PATH=./data/db/backups/mongo

# ── Nginx Proxy Manager ─────────────────────────────────
NPM_DB=npm
NPM_INITIAL_ADMIN_EMAIL=
NPM_INITIAL_ADMIN_PASSWORD=
NPM_APP_PATH=./docker/npm
NPM_DATA_PATH=./data/db/npm

# ── Nextcloud ─────────────────────────────────────────────
NEXTCLOUD_DB=nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.home.arpa
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_APP_PATH=./docker/nextcloud
NEXTCLOUD_DATA_PATH=./data/storage

# ── Vaultwarden ──────────────────────────────────────────
VAULTWARDEN_DB=vaultwarden
VAULTWARDEN_DOMAIN=http://localhost:8089
# printf 'password1234' | argon2 yoursalt16chars! -id -e
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_APP_PATH=./docker/vaultwarden
VAULTWARDEN_DATA_PATH=./data/db/vaultwarden

# ── Kavita ────────────────────────────────────────────────
KAVITA_APP_PATH=./docker/kavita
KAVITA_BACKUP_PATH=./data/db/kavita
KAVITA_DATA_PATH=./data/storage/admin/files/Library

# ── Wealthfolio ──────────────────────────────────────────
# openssl rand -base64 32
WF_SECRET_KEY=
# printf 'password1234' | argon2 yoursalt16chars! -id -e
WF_AUTH_PASSWORD_HASH=
WF_CORS_ALLOW_ORIGINS=http://wealthfolio.home.arpa
WEALTHFOLIO_DATA_PATH=./data/db/wealthfolio

# ── LLM (OpenAI-compatible endpoint; shared by AI services) ──
LLM_BASE_URL=
# if the endpoint has no auth — keep a non-empty placeholder value
LLM_API_KEY=not-needed
LLM_CHAT_MODEL=
# context window of the chat model; AnythingLLM cannot auto-detect it on
# llama.cpp, keep close to llama-server n_ctx with some headroom
LLM_MODEL_TOKEN_LIMIT=
# separate url/key for embeddings; empty = fall back to LLM_* values
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# ── AnythingLLM ──────────────────────────────────────────
ANYTHINGLLM_DB=anythingllm
# openssl rand -hex 32
ANYTHINGLLM_JWT_SECRET=
ANYTHINGLLM_DATA_PATH=./data/db/anythingllm

# ── LibreChat ────────────────────────────────────────────
LIBRECHAT_DB=librechat
LIBRECHAT_RAG_DB=librechat_rag
LIBRECHAT_DOMAIN=http://librechat.home.arpa
# openssl rand -hex 32
LIBRECHAT_CREDS_KEY=
# openssl rand -hex 16
LIBRECHAT_CREDS_IV=
# openssl rand -hex 32
LIBRECHAT_JWT_SECRET=
# openssl rand -hex 32   (different value)
LIBRECHAT_JWT_REFRESH_SECRET=
# openssl rand -base64 32
MEILI_MASTER_KEY=
LIBRECHAT_APP_PATH=./docker/librechat
LIBRECHAT_DATA_PATH=./data/db/librechat

# ── Paperclip ────────────────────────────────────────────
PAPERCLIP_DB=paperclip
PAPERCLIP_PUBLIC_URL=http://paperclip.home.arpa
# extra hostnames/IPs for LAN access, comma-separated
PAPERCLIP_ALLOWED_HOSTNAMES=
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32   (different value)
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
PAPERCLIP_DATA_PATH=./data/db/paperclip
